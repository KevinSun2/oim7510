    {
      "id": "BYtC",
      "code_hash": "d1c133979c9b6cabe61a60c9e1674845",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">The second way: <code>.get()</code> gives <code>None</code> when the key is missing, or the fallback you hand it as a second value.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "RGSE",
      "code_hash": "d36c2544a9da3d7ca41366697fa9ad45",
