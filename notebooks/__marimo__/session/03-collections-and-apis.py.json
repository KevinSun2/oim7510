      ],
      "console": []
    },
    {
      "id": "Xref",
      "code_hash": "fa78846656269b180856d4eef11fb493",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"asking-before-you-read\">Asking before you read</h2>\n<span class=\"paragraph\"><code>goog_quote[\"Volume\"]</code> would stop with a <code>KeyError</code>, because there is no such key. The first way to ask: <code>in</code> answers <code>True</code> or <code>False</code>.</span></span>"
          }
        }
      ],
      "console": []
    },
    {
      "id": "SFPL",
      "code_hash": "eea132fed27efd6f1db408185f7d665e",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<pre class='text-xs'>True</pre>"
