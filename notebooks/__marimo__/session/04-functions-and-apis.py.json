        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">Without the <code>headers=</code> line, the server answered <strong>401</strong>, with the message \"Missing x-token header.\" It needs to know who sent a message so it can show the right author's name on the board (mine shows as \"Kevin\"), and so it can tell who posted what, the same way a form on a website needs to know who is submitting it rather than accepting anonymous, unaccountable data.</span></span>"
          }
